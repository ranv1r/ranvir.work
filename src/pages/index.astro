---
const experience = [
  {
    role: "Founder, CEO",
    org: "Lexolo",
    url: "https://lexolo.ai",
    dates: "Apr 2025 – Present",
    desc: "Building an AI-powered language-learning app end to end, from the SwiftUI frontend to the LLM-driven content backend.",
  },
  {
    role: "Software Engineer II",
    org: "Electronic Arts",
    dates: "May 2024 – Jan 2025",
    desc: "Modernized EA's test automation stack and CI infrastructure for live-service titles.",
  },
  {
    role: "Software Engineer I",
    org: "Electronic Arts",
    dates: "Sep 2022 – May 2024",
    desc: "Built cross-platform test microservices and led the team's CI/CD migration.",
  },
  {
    role: "Software Engineer I (Contract)",
    org: "Electronic Arts",
    dates: "Feb 2021 – Sep 2022",
    desc: "Grew end-to-end and integration test coverage across desktop platforms.",
  },
  {
    role: "Software Engineer I (Contract)",
    org: "Facebook",
    dates: "Apr 2019 – Jul 2020",
    desc: "Automated cross-app video benchmarking for Meta's app family.",
  },
];

const education = [
  {
    role: "Bachelor of Arts, Geography",
    org: "University of Washington",
    dates: "2017 – 2022",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Ranvir Chhina — Software Engineer" />
    <link rel="icon" href="/favicon.ico" />
    <title>Ranvir Chhina</title>
  </head>
  <body>
    <main class="page">
      <div class="header">
        <div class="header-text">
          <h1 class="name">Ranvir Chhina</h1>
          <p class="role-line">Software Engineer · Vancouver, BC</p>
          <div class="links-row">
            <a href="mailto:ranvirchhina25@gmail.com">Email</a>
            <span class="sep">·</span>
            <a href="https://github.com/ranv1r" target="_blank" rel="noopener">GitHub</a>
            <span class="sep">·</span>
            <a href="https://www.linkedin.com/in/chhinaranvir/" target="_blank" rel="noopener">LinkedIn</a>
            <span class="sep">·</span>
            <a href="/resume.pdf" target="_blank" rel="noopener">Resume</a>
          </div>
        </div>
        <div class="avatar-frame">
          <img class="avatar" src="/avatar.jpg" alt="Ranvir Chhina" width="112" height="112" />
        </div>
      </div>

      <section>
        <h2 class="section-heading">Experience</h2>
        {experience.map((e) => (
          <div class="entry">
            <div class="entry-head">
              <span>
                <strong>{e.role}</strong>{" "}
                <span class="org">
                  —{" "}
                  {e.url ? (
                    <a class="org-link" href={e.url} target="_blank" rel="noopener">{e.org}</a>
                  ) : (
                    e.org
                  )}
                </span>
              </span>
              <span class="entry-date">{e.dates}</span>
            </div>
            <p class="entry-desc">{e.desc}</p>
          </div>
        ))}
      </section>

      <section>
        <h2 class="section-heading">Education</h2>
        {education.map((ed) => (
          <div class="entry">
            <div class="entry-head">
              <span><strong>{ed.role}</strong> <span class="org">— {ed.org}</span></span>
              <span class="entry-date">{ed.dates}</span>
            </div>
          </div>
        ))}
      </section>
    </main>

    <style>
      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        color: #1a1a1a;
        font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
      }

      .page {
        max-width: 680px;
        margin: 0 auto;
        padding: 96px 24px 80px;
      }

      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        margin-bottom: 104px;
      }

      .header-text {
        flex: 1;
      }

      .avatar-frame {
        flex-shrink: 0;
        width: 112px;
        height: 112px;
        border-radius: 20%;
        overflow: hidden;
      }

      .avatar {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(2);
        transform-origin: 50% 40%;
      }

      .name {
        text-align: left;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin: 0 0 12px;
      }

      .role-line {
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #999;
        margin: 0 0 18px;
      }

      .links-row {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: wrap;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .links-row a {
        color: #555;
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }

      .links-row a:hover {
        color: #1a1a1a;
        border-bottom-color: #1a1a1a;
      }

      .links-row .sep {
        color: #ccc;
        margin: 0 8px;
      }

      section + section {
        margin-top: 44px;
      }

      .section-heading {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: #333;
        border-bottom: 1px solid #e6e6e6;
        padding-bottom: 8px;
        margin: 0 0 20px;
      }

      .entry {
        margin-bottom: 22px;
      }

      .entry:last-child {
        margin-bottom: 0;
      }

      .entry-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 16px;
        font-size: 15px;
      }

      .entry-head .org {
        font-weight: 400;
        color: #666;
      }

      .org-link {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid #999;
      }

      .org-link:hover {
        color: #4947c4;
        border-bottom-color: #4947c4;
      }

      .entry-date {
        font-size: 12.5px;
        color: #999;
        font-weight: 400;
        white-space: nowrap;
      }

      .entry-desc {
        font-size: 13.5px;
        line-height: 1.55;
        color: #666;
        margin: 5px 0 0;
      }

      @media (max-width: 600px) {
        .page {
          padding: 56px 22px 64px;
        }

        .header {
          flex-direction: column-reverse;
          text-align: center;
        }

        .name,
        .role-line {
          text-align: center;
        }

        .links-row {
          justify-content: center;
        }

        .entry-head {
          flex-direction: column;
          gap: 2px;
        }
      }
    </style>
  </body>
</html>
